# Cấu hình máy chủ ChungAuto – sao chép thành .env rồi sửa (KHÔNG đưa .env lên git)

# ---- Docker (docker-compose.yml) ----
DOMAIN=chungauto.vn
# mật khẩu database: chỉ dùng chữ và số (nằm trong đường dẫn kết nối)
DB_PASSWORD=doi-thanh-chuoi-ngau-nhien-dai

# ---- Tài khoản quản trị tạo lần đầu khởi động (chỉ tạo khi email chưa có) ----
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=DoiMatKhauNay123
ADMIN_NAME=Quản trị ChungAuto

# ---- Chạy không dùng Docker (PM2 / node trực tiếp) ----
# DATABASE_URL=postgres://chungauto:matkhau@localhost:5432/chungauto
# PUBLIC_URL=https://chungauto.vn
# PORT=8080
# HOST=127.0.0.1

# ---- Tuỳ chọn (đã có giá trị mặc định) ----
# SESSION_DAYS=7
# COOKIE_SECURE=true          # false nếu chạy thử bằng http (không có HTTPS)
# TRUST_PROXY=true            # đứng sau Caddy / Nginx
# LEAD_RATE_LIMIT=5           # số lần gửi form tư vấn / LEAD_RATE_WINDOW_MIN phút / 1 IP
# LEAD_RATE_WINDOW_MIN=10
# LOGIN_RATE_LIMIT=20
# LOGIN_RATE_WINDOW_MIN=15
# MAX_FAILED_LOGINS=5         # nhập sai liên tiếp → khoá tạm LOCK_MINUTES phút
# LOCK_MINUTES=15
